import { IconButton } from "../components/button.slint";
import { Slider } from "../components/slider.slint";
import { CallbackHandler } from "../callbacks.slint";

export component Nowplaying inherits Rectangle {

    Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;
        HorizontalLayout {
            cross-axis-alignment: center;
            alignment: center;
            x: 20px;
            Rectangle {
                width: 300px;
                height: 440px;
                VerticalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 100%;
                        height: 300px;
                        background: rgba(0, 0, 0, 0.1);
                        border-radius: 16px;
                        clip: true;
                        Image {
                            source: CallbackHandler.hasAlbumArt ? CallbackHandler.albumArt : @image-url("../icons/artist.svg");
                            width: CallbackHandler.hasAlbumArt ? 100% : 60%;
                            height: CallbackHandler.hasAlbumArt ? 100% : 60%;
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 140px;
                        HorizontalLayout {
                            alignment: center;
                            IconButton {
                                height: 100px;
                                width: 100px;
                                icon: @image-url("../icons/skip_previous.svg");
                                clicked => { CallbackHandler.previousClicked(); }
                            }

                            IconButton {
                                height: 100px;
                                width: 100px;
                                icon: @image-url("../icons/play_pause.svg");
                                clicked => { CallbackHandler.playPauseClicked(); }
                            }

                            IconButton {
                                height: 100px;
                                width: 100px;
                                icon: @image-url("../icons/skip_next.svg");
                                clicked => { CallbackHandler.nextClicked(); }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 440px;
                width: 100%;
                VerticalLayout {
                    Rectangle {
                        width: 100%;
                        height: 300px;
                        VerticalLayout {
                            x: 30px;
                            alignment: center;
                            Text {
                                text: CallbackHandler.currentTitle;
                                font-size: 40pt;
                                font-family: "Roboto";
                                overflow: elide;
                            }

                            Text {
                                text: CallbackHandler.currentArtist;
                                font-size: 20pt;
                                font-family: "Roboto";
                                overflow: elide;
                            }
                        }

                    }

                    Rectangle {
                        width: 100%;
                        height: 100px;

                        HorizontalLayout {
                            alignment: start;
                            cross-axis-alignment: center;
                            spacing: 10px;
                            x: 10px;
                            Rectangle {
                                width: 400px;
                                height: 150px;
                                Slider {
                                    width: 100%;
                                    value <=> CallbackHandler.sliderValue;
                                    minimum: 0;
                                    maximum: CallbackHandler.duration;
                                    changed(v) => { CallbackHandler.sliderDragging = true; }
                                    released(v) => {
                                        CallbackHandler.sliderDragging = false;
                                        CallbackHandler.seekRequested(v);
                                    }
                                }
                            }

                            Text {
                                text: CallbackHandler.positionText + " / " + CallbackHandler.durationText;
                                font-size: 12pt;
                                font-family: "Roboto";
                            }
                        }
                    }

                    Rectangle {
                        width: 100%;
                        height: 40px;
                        HorizontalLayout {
                            alignment: start;
                            cross-axis-alignment: center;
                            spacing: 10px;
                            x: 10px;
                            IconButton {
                                width: 40px;
                                height: 40px;
                                icon: CallbackHandler.muted || CallbackHandler.volume == 0
                                    ? @image-url("../icons/volume_off.svg")
                                    : @image-url("../icons/volume_up.svg");
                                clicked => { CallbackHandler.muteToggled(); }
                            }

                            Rectangle {
                                width: 300px;
                                height: 40px;
                                Slider {
                                    width: 100%;
                                    value <=> CallbackHandler.volume;
                                    minimum: 0;
                                    maximum: 100;
                                    changed(v) => { CallbackHandler.volumeDragging = true; }
                                    released(v) => {
                                        CallbackHandler.volumeDragging = false;
                                        CallbackHandler.volumeChanged(v);
                                    }
                                }
                            }

                            Text {
                                text: CallbackHandler.muted ? "Aus" : round(CallbackHandler.volume) + "%";
                                font-size: 12pt;
                                font-family: "Roboto";
                            }
                        }
                    }
                }
            }
        }
    }
}
