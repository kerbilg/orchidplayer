export component Slider inherits Rectangle {
    in-out property <float> value: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);
    callback released(float);

    min-height: 48px;

    property <float> progress: (root.value - root.minimum) / (root.maximum - root.minimum);

    // Spur
    Rectangle {
        width: 100%;
        height: 10px;
        border-radius: 16px;
        background: rgba(0, 0, 0, 0.1);
        y: (parent.height - self.height) / 2;
    }

    // Gefüllt – bündig mit dem Griff-Mittelpunkt
    Rectangle {
        x: 0;
        width: root.progress * (parent.width - thumb.width) + thumb.width / 2;
        height: 10px;
        border-radius: 16px;
        background: #111111;
        y: (parent.height - self.height) / 2;
    }

    // Griff – nur beim Pressen
    thumb := Rectangle {
        visible: touch.pressed;
        x: root.progress * (parent.width - self.width);
        width: 24px;
        height: 24px;
        border-radius: 16px;
        background: #111111;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;

        // Ziehen: nur wenn gedrückt
        moved => {
            if (touch.pressed) {
                root.set-value(touch.mouse-x);
            }
        }

        // Drücken: sofort springen + Loslassen melden
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                root.set-value(touch.mouse-x);
            }
            if (ev.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
    }

    // Zentrale Wertsetzung – clamp + changed
    function set-value(x: length) {
        root.value = clamp(
            (x / touch.width) * (root.maximum - root.minimum) + root.minimum,
            root.minimum, root.maximum
        );
        root.changed(root.value);
    }
}